{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker name stays "getrecruitercalls" on purpose: the Cloudflare Workers Builds project, the
  // workers.dev URL and the D1 database are linked to it. The public brand/domain is GetShortlisted.
  "name": "getrecruitercalls",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",

  // Static site is generated into ./public by build.mjs (runs automatically before dev/deploy).
  "build": {
    "command": "node build.mjs"
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only /api/* hits the Worker code; every other request is served straight from static assets (fast + cheap).
    "run_worker_first": ["/api/*"]
  },

  // Free address: https://getrecruitercalls.<your-account>.workers.dev
  "workers_dev": true,

  // STEP 2 (after getshortlisted.in is added to this Cloudflare account and its nameservers point to Cloudflare): uncomment to attach the domain.
  // "routes": [
  //   { "pattern": "getshortlisted.in", "custom_domain": true },
  //   { "pattern": "www.getshortlisted.in", "custom_domain": true }
  // ],

  // D1 database that stores every lead (form submission).
  // No database_id needed: `wrangler deploy` creates the database automatically on first deploy,
  // and the Worker creates the `leads` table itself on the first form submission.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "getrecruitercalls-db",
      "migrations_dir": "migrations"
    }
  ],

  // STEP 3 (after Email Routing is enabled for getshortlisted.in and the Gmail below is VERIFIED):
  // uncomment to email every lead. Until then leads are only saved in the D1 database.
  // "send_email": [
  //   {
  //     "name": "SEND_EMAIL",
  //     "destination_address": "nishit.salian02@gmail.com"
  //   }
  // ],

  "vars": {
    "NOTIFY_TO": "nishit.salian02@gmail.com",
    "NOTIFY_FROM": "leads@getshortlisted.in",
    "SITE_URL": "https://getshortlisted.in"
  },

  "observability": { "enabled": true }
}
